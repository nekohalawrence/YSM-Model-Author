{
	"format_version": "1.19.0",
	"animation_controllers": {
		"projectile.post_main": {
			"states": {
				"default": {
					"animations": ["empty"],
					"transitions": [
						{
							"explode": "ysm.in_ground"
						}
					],
					"blend_transition": 0.05,
					"blend_via_shortest_path": true
				},
				"explode": {
					"animations": [
						{
							"explode": "ysm.in_ground"
						}
					],
					"transitions": [
						{
							"ground": "q.all_animations_finished"
						}
					],
					"blend_transition": 0.05,
					"blend_via_shortest_path": true
				},
				"ground": {
					"animations": ["ground_animation"]
				}
			}
		}
	}
}