{
	"format_version": "1.19.0",
	"animation_controllers": {
		"player.parallel_0": {
			"states": {
				"default": {
					"animations": ["parallel0", "parallel1", "parallel2", "parallel3", "parallel4", "parallel5", "parallel6", "parallel7"]
				}
			}
		},
		"player.parallel_3": {
			"states": {
				"default": {
					"transitions": [
						{"ready": "q.vertical_speed<=-7 && !ctrl.fly && !ctrl.elytra_fly"}
					]
				},
				"ready": {
					"transitions": [
						{"play": "q.is_on_ground"}
					]
				},
				"play": {
					"animations": ["jump2"],
					"transitions": [
						{"default": "q.any_animation_finished"}
					]
				}
			}
		},
		"player.parallel_4": {
			"states": {
				"default": {
					"transitions": [
						{"start": "ctrl.jump && q.vertical_speed > 0"}
					]
				},
				"start": {
					"animations": ["jump_start"],
					"transitions": [
						{"default": "!ctrl.jump"},
						{"sky": "q.any_animation_finished"}
					]
				},
				"sky": {
					"animations": ["jump_fly"],
					"transitions": [
						{"default": "!ctrl.jump"}
					]
				}
			}
		},
