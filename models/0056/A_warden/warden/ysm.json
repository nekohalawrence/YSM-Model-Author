  "properties": {
    "height_scale": 0.7,
    "width_scale": 0.7,
    "extra_animation": {
      "extra0": "#模型配置",
      "#坚守者默认动作": "§b坚守者动作合集",
      "extra1": "§3提裙礼",
      "extra5": "§3坐下_1",
      "extra6": "§3坐下_2",
      "extra7": "§3悬浮坐下",
      "extra8": "§e一小杯民主"
    },
    "extra_animation_classify": [
      {
        "id": "坚守者默认动作",
        "extra_animation": {
          "#return": "§c返回按钮",
          "extra2": "§3坚守者出现",
          "extra3": "§3坚守者消失",
          "extra4": "§3坚守者搜索"
        }
      }
    ],
    "extra_animation_buttons": [
      {
        "id":"模型配置",
        "name": "模型配置",
        "config_forms": [
          {
            "type": "range",
            "title": "角色大小",
            "description": "用以调整角色大小",
            "value": "v.player_size",
            "step": 0.05,
            "min": 1,
            "max": 1.6
          },
          {
            "type": "radio",
            "title": "震动频率",
            "description": "手臂装饰的震动频率",
            "value": "v.vibrate",
            "labels": {
              "缓慢": "v.vibrate=0;",
              "快速": "v.vibrate=1;"
            }
          },
          {
            "type": "checkbox",
            "title": "隐藏悬浮臂",
            "description": " 注：悬浮臂有替换工具动画，如有动画缺失优先检查此选项",
             "value": "v.hover"
          },
          {
            "type": "checkbox",
            "title": "显示眼罩",
            "description": " 开关坚守者眼罩",
             "value": "v.patch"
          }
        ]
      }
    ],
    "preview_animation": "stage",
    "default_texture": "warden",
    "render_layers_first": false,
    "free": true,
    "disable_preview_rotation": true
  },
  "files": {
    "player": {
      "model": {
        "main": "models/main.json",
        "arm": "models/arm.json"
      },
      "animation": {
