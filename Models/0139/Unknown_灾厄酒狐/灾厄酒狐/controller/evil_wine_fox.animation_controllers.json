{
	"format_version": "1.19.0",
	"animation_controllers": {
		"player.post_main": {
			"states": {
				"default": {
					"animations": ["new_idle_empty"],
					"transitions": [
						{"idle1": "v.next_idle == 1 && ctrl.idle && !ctrl.playing_extra_animation"},
						{"idle2": "v.next_idle == 2 && ctrl.idle && !ctrl.playing_extra_animation"},
						{"idle3": "v.next_idle == 3 && ctrl.idle && !ctrl.playing_extra_animation"},
						{"idle4": "v.next_idle == 4 && ctrl.idle && !ctrl.playing_extra_animation"},
						{"idle5": "v.next_idle == 5 && ctrl.idle && !ctrl.playing_extra_animation"}
					],
					"blend_transition": 0.2
				},
				"idle1": {
					"animations": ["new_idle_1"],
					"on_exit": ["v.next_idle = 0;"],
					"transitions": [
						{"default": "q.all_animations_finished || !ctrl.idle || ctrl.playing_extra_animation"}
					],
					"blend_transition": 0.2
				},
				"idle2": {
					"animations": ["new_idle_2"],
					"on_exit": ["v.next_idle = 0;"],
					"transitions": [
						{"default": "q.all_animations_finished || !ctrl.idle || ctrl.playing_extra_animation"}
					],
					"blend_transition": 0.2
				},
				"idle3": {
					"animations": ["new_idle_3"],
					"on_exit": ["v.next_idle = 0;"],
					"transitions": [
						{"default": "q.all_animations_finished || !ctrl.idle || ctrl.playing_extra_animation"}
					],
					"blend_transition": 0.2
				},
				"idle4": {
					"animations": ["new_idle_4"],
					"on_exit": ["v.next_idle = 0;"],
					"transitions": [
						{"default": "q.all_animations_finished || !ctrl.idle || ctrl.playing_extra_animation"}
					],
					"blend_transition": 0.2
				},
				"idle5": {
					"animations": ["new_idle_5"],
					"on_exit": ["v.next_idle = 0;"],
					"transitions": [
						{"default": "q.all_animations_finished || !ctrl.idle || ctrl.playing_extra_animation"}
					],
					"blend_transition": 0.2
				}
			}
		},
		"player.parallel_7": {
			"states": {
				"default": {
					"transitions": [
						{"extra22": "!(q.health/q.max_health>0.5&&ysm.has_any_curios('head','goety_revelation:ascension_halo'))&&v.roaming.halo"},
						{"extra21": "(q.health/q.max_health>0.5&&ysm.has_any_curios('head','goety_revelation:ascension_halo'))&&!v.roaming.halo"},
						{"extra24": "!(q.health/q.max_health<0.5&&ysm.has_any_curios('head','goety_revelation:ascension_halo'))&&v.roaming.halo2"},
						{"extra23": "(q.health/q.max_health<0.5&&ysm.has_any_curios('head','goety_revelation:ascension_halo'))&&!v.roaming.halo2"},
						{"extra26": "!ysm.has_any_curios('head','goety_revelation:halo_of_the_end')&&v.roaming.halo3"},
						{"extra25": "ysm.has_any_curios('head','goety_revelation:halo_of_the_end')&&!v.roaming.halo3"}
					],
					"blend_transition": 0.2
				},
				"extra22": {
					"animations": [
						{"extra22": "q.health/q.max_health>0.5"}
					],
					"on_exit": ["v.roaming.halo=0;"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					],
					"blend_transition": 0.2
				},
				"extra21": {
					"animations": [
						{"extra21": "q.health/q.max_health>0.5"}
					],
					"on_exit": ["v.roaming.halo=1;"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					],
					"blend_transition": 0.2
				},
				"extra24": {
					"animations": [
						{"extra24": "q.health/q.max_health<0.5"}
					],
					"on_exit": ["v.roaming.halo2=0;"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					],
					"blend_transition": 0.2
				},
				"extra23": {
					"animations": [
						{"extra23": "q.health/q.max_health<0.5"}
					],
					"on_exit": ["v.roaming.halo2=1;"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					],
					"blend_transition": 0.2
				},
				"extra26": {
					"animations": ["extra26"],
					"on_exit": ["v.roaming.halo3=0;"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					]
				},
				"extra25": {
					"animations": ["extra25"],
					"on_exit": ["v.roaming.halo3=1;"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					]
				}
			}
		},
		"player.parallel_6": {
			"states": {
				"default": {
					"animations": ["attack_empty"],
					"on_exit": ["v.swing_sword=0;"],
					"transitions": [
						{"attack1": "v.swing_sword&&!v.jump"},
						{"attack_jump": "v.swing_sword&&v.jump"}
					]
				},
				"attack1": {
					"animations": [
						{"sword_attack_01": "!ctrl.idle"},
						{"sword_idle_attack_01": "ctrl.idle"}
					],
					"on_exit": ["v.swing_sword=0;"],
					"transitions": [
						{"attack2": "v.swing_sword&&!v.jump"},
						{"default": "q.all_animations_finished"},
						{"attack_jump": "v.swing_sword&&v.jump"}
					],
					"blend_transition": 0.05,
					"blend_via_shortest_path": true
				},
				"attack2": {
					"animations": [
						{"sword_attack_02": "!ctrl.idle"},
						{"sword_idle_attack_02": "ctrl.idle"}
					],
					"on_exit": ["v.swing_sword=0;"],
					"transitions": [
						{"attack3": "v.swing_sword&&!v.jump"},
						{"default": "q.all_animations_finished"},
						{"attack_jump": "v.swing_sword&&v.jump"}
					],
					"blend_transition": 0.05,
					"blend_via_shortest_path": true
				},
				"attack3": {
					"animations": [
						{"sword_attack_03": "!ctrl.idle"},
						{"sword_idle_attack_03": "ctrl.idle"}
					],
					"on_exit": ["v.swing_sword=0;"],
					"transitions": [
						{"default": "q.all_animations_finished"},
						{"attack1": "v.swing_sword&&!v.jump"},
						{"attack_jump": "v.swing_sword&&v.jump"}
					],
					"blend_transition": {
						"0.0": 1,
						"0.0056": 0.96985,
						"0.0111": 0.88302,
						"0.0167": 0.75,
						"0.0222": 0.58682,
						"0.0278": 0.41318,
						"0.0333": 0.25,
						"0.0389": 0.11698,
						"0.0445": 0.03015,
						"0.05": 0
					},
					"blend_via_shortest_path": true
				},
				"attack_jump": {
					"animations": ["sword_jump_attack"],
					"on_exit": ["v.swing_sword=0;"],
					"transitions": [
						{"default": "q.all_animations_finished"},
						{"attack1": "v.swing_sword&&!v.jump"}
					],
					"blend_transition": 0.05,
					"blend_via_shortest_path": true
				}
			}
		}
	}
}