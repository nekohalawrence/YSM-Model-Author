{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "variant_tags.schema.json",
  "title": "变体对照表 variant_tags.json",
  "description": "模型文件重命名时识别变体词：键=规范英文变体名（如 swimsuit/new），值={cn:[中文变体写法], en:[英文变体写法]}。未收录的变体词在重命名时被丢弃，不追加到文件名。",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "zh": { "type": "array", "items": { "type": "string" } },
      "en": { "type": "array", "items": { "type": "string" } }
    }
  }
}
