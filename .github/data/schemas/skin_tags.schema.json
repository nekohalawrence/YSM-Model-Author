{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skin_tags.schema.json",
  "title": "皮肤标签表 skin_tags.json",
  "description": "皮肤/变体标签：common=通用皮肤词，其余键=作品专属皮肤词；每项 {cn:[中文词], en:[英文词]}。剥离皮肤时用 common + 当前作品专属合并词表。",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "zh": { "type": "array", "items": { "type": "string" } },
      "en": { "type": "array", "items": { "type": "string" } }
    }
  }
}
