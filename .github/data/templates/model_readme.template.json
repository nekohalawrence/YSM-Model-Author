{
  "version": 1,
  "description": "模型 README 生成模板。由 _Template/ 转化：元信息/作者元信息.md（Author/Co-creator 字段）、平台/SocialPlatform.md、平台/SupportPlatform.md（平台分类）、角色/Role.md（Role 默认值）。脚本按 sections 顺序渲染，字段值从 authors.json / platform_map.json / category_map.json / .ysm 填充。",
  "title": "# {model_name}",
  "sections": [
    {
      "key": "model_details",
      "heading": "## Model Details",
      "summary": "Model Details",
      "collapsible": true,
      "fields": [
        { "key": "category", "label": "**Category**" },
        { "key": "game", "label": "**Game**", "indent": 1 }
      ]
    },
    {
      "key": "author_details",
      "heading": "## Author",
      "summary": "Author",
      "collapsible": false,
      "note": "位于 Model Details 的 <details> 内，不单独折叠；含 Name/Role/平台（作者元信息.md 结构）"
    },
    {
      "key": "co_creator_details",
      "heading": "## Co-creator",
      "summary": "Co-creator",
      "collapsible": false,
      "note": "同 Author，内容来自 models_meta.json 或 .ysm 解析（co-creator 识别）"
    },
    {
      "key": "preview_images",
      "heading": "## Preview Images",
      "summary": "Preview Images",
      "collapsible": true,
      "open": true
    }
  ],
  "author_block": {
    "name_line": "- **Name**: {names}",
    "role_line": "  - **Role**: {role}",
    "role_default": "#模型 #动作 #动画 | #Model #Motion #Animation",
    "id_line": "- **Author ID**: `{author_id}`",
    "platform_order": ["SocialPlatform", "SupportPlatform", "OtherPlatform", "GroupChat"],
    "platform_header": "  - **{field}**: #{tags}",
    "platform_item": "    - **{platform}**: [{label}]({url})",
    "platform_plain_item": "    - **{platform}**: {value}",
    "social_platforms": ["Bilibili", "Twitter", "Discord", "YouTube", "Pixiv", "X"],
    "support_platforms": ["Afdian", "Ko-fi", "UniFans", "PixivFanbox", "Patreon", "爱发电"]
  }
}
